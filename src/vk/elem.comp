// variants: silu_mul:OP_SILU=1 gate:OP_GATE=1 gdn_gb:OP_GB=1 ksum:OP_KSUM=1 to_f16:OP_F16=1 quant_q8:OP_Q8=1
// small element-wise ops
#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uvec2 a, b, c, d, e, f; uint n, p0, p1; } pc;
void main() {
  const uint i = gl_GlobalInvocationID.y * 65535u * 256u + gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
#ifdef OP_SILU
  // a = silu(a) * b
  F32 a = F32(pc.a); F32 b = F32(pc.b);
  const float x = a.d[i];
  a.d[i] = x / (1.0 + exp(-x)) * b.d[i];
#elif defined(OP_GATE)
  // attention output o (a) *= sigmoid(gate part of the interleaved q|gate rows (b)); p0 = hd, p1 = nh
  F32 a = F32(pc.a); F32 b = F32(pc.b);
  const uint hd = pc.p0, nh = pc.p1, dd = i % hd, h = (i / hd) % nh, t = i / (hd * nh);
  const float gt = b.d[t * nh * hd * 2u + h * hd * 2u + hd + dd];
  a.d[i] = a.d[i] / (1.0 + exp(-gt));
#elif defined(OP_GB)
  // GDN gates: g = softplus(alpha + dt_bias) * A, beta = sigmoid(beta_raw); p0 = nv
  F32 al = F32(pc.a); F32 br = F32(pc.b); F32 dtb = F32(pc.c); F32 A = F32(pc.d); F32 g = F32(pc.e); F32 be = F32(pc.f);
  const uint h = i % pc.p0;
  const float x = al.d[i] + dtb.d[h];
  const float sp = x > 20.0 ? x : log(1.0 + exp(x));
  g.d[i] = sp * A.d[h];
  be.d[i] = 1.0 / (1.0 + exp(-br.d[i]));
#elif defined(OP_F16)
  // activations f32 [T][K] -> packed f16 words, rows past T zero (cooperative-matrix tiles): p0 = valid words
  F32 a = F32(pc.a); U32 b = U32(pc.b);
  b.d[i] = i < pc.p0 ? packHalf2x16(vec2(a.d[2u * i], a.d[2u * i + 1u])) : 0u;
#elif defined(OP_Q8)
  // activations f32 -> int8 per 32-element block (DP4A matvec): one invocation per block, i = block;
  // a = x, b = codes (8 words per block), c = block scales
  F32 a = F32(pc.a); U32 b = U32(pc.b); F32 c = F32(pc.c);
  float amax = 0.0;
  for (uint k = 0u; k < 32u; k++) amax = max(amax, abs(a.d[32u * i + k]));
  const float d = amax / 127.0, id = d > 0.0 ? 1.0 / d : 0.0;
  for (uint k = 0u; k < 8u; k++) {
    uint wv = 0u;
    for (uint j = 0u; j < 4u; j++) wv |= (uint(clamp(int(round(a.d[32u * i + 4u * k + j] * id)), -127, 127)) & 0xffu) << (8u * j);
    b.d[8u * i + k] = wv;
  }
  c.d[i] = d;
#elif defined(OP_KSUM)
  // split-K GEMM: b[i] (+)= sum over p0 slices of a[s*n + i]; p1 = accumulate
  F32 a = F32(pc.a); F32 b = F32(pc.b);
  float s = 0.0;
  for (uint k = 0u; k < pc.p0; k++) s += a.d[k * pc.n + i];
  b.d[i] = pc.p1 != 0u ? b.d[i] + s : s;
#endif
}
