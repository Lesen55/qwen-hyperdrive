// Prefill GEMM on matrix hardware (VK_KHR_cooperative_matrix, 16x16x16 f16 -> f32):
// C[t][n] = sum_k X16[t][k] W16[n][k] with A = X16 (row-major, rows padded to 64 with zeros) and
// B = W16 read as K x N column-major.  Workgroup tile 64 tokens x 128 rows = four 32x64 blocks; each
// subgroup takes blocks gl_SubgroupID, +gl_NumSubgroups, ... (any subgroup size works) and keeps 2x4
// accumulators (2 A + 4 B fragment loads per 8 MMAs).  The tile goes through shared memory so partial tiles are stored with bounds checks.
#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "common.glsl"
layout(buffer_reference, std430, buffer_reference_align = 16) buffer H16 { float16_t d[]; };
layout(local_size_x = 128) in;
layout(push_constant) uniform PC { uvec2 w, x, y, tab; uint K, N, T, rb, ldx, ldy, acc, wide, kg; } pc;
shared float Cs[64 * 128];  // 32 KiB
#define ACC coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
void main() {
  H16 W = H16(pc.w);
  H16 X = H16(pc.x);
  F32 y = F32(pc.y);
  const uint r0 = gl_WorkGroupID.x * 128u, c0 = gl_WorkGroupID.y * 64u;
  const uint nk = pc.K / 16u;
  const uint ks = gl_WorkGroupID.z * pc.kg, ke = min(nk, ks + pc.kg);  // kg: 16-wide k steps per slice
  for (uint b = gl_SubgroupID; b < 4u; b += gl_NumSubgroups) {
    const uint bt = (b / 2u) * 32u, br = (b % 2u) * 64u;
    ACC c[2][4];
    for (uint i = 0u; i < 2u; i++) for (uint j = 0u; j < 4u; j++) c[i][j] = ACC(0.0);
    const uint xa = (c0 + bt) * pc.K, wb = (r0 + br) * pc.K;
    for (uint k = ks; k < ke; k++) {
      coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a[2];
      coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bm[4];
      for (uint i = 0u; i < 2u; i++) coopMatLoad(a[i], X.d, xa + 16u * i * pc.K + k * 16u, pc.K, gl_CooperativeMatrixLayoutRowMajor);
      for (uint j = 0u; j < 4u; j++) coopMatLoad(bm[j], W.d, wb + 16u * j * pc.K + k * 16u, pc.K, gl_CooperativeMatrixLayoutColumnMajor);
      for (uint i = 0u; i < 2u; i++) for (uint j = 0u; j < 4u; j++) c[i][j] = coopMatMulAdd(a[i], bm[j], c[i][j]);
    }
    for (uint i = 0u; i < 2u; i++)
      for (uint j = 0u; j < 4u; j++)
        coopMatStore(c[i][j], Cs, (bt + 16u * i) * 128u + br + 16u * j, 128u, gl_CooperativeMatrixLayoutRowMajor);
  }
  barrier();
  const bool split = gl_NumWorkGroups.z > 1u;
  const uint yoff = gl_WorkGroupID.z * pc.T * pc.ldy;
  for (uint e = gl_LocalInvocationID.x; e < 64u * 128u; e += 128u) {
    const uint t = c0 + e / 128u, n = r0 + e % 128u;
    if (t >= pc.T || n >= pc.N) continue;
    const uint o = t * pc.ldy + n;
    const float v = Cs[e];
    if (split) y.d[yoff + o] = v;
    else y.d[o] = pc.acc != 0u ? y.d[o] + v : v;
  }
}
